# BreatheWise AI Environment Variables
# Copy this file to .env.local and fill in optional credentials.
# Never commit real values. All secret keys are read server-side only.

# Optional: Force Demo Mode ("true" or "false")
NEXT_PUBLIC_DEMO_MODE=false

# Optional: LLM Provider (supports Gemini or OpenAI; falls back to grounded AI engine if omitted)
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=gemini-2.5-flash
AI_DAILY_REQUEST_CAP=200

# Optional: Air Quality API keys (Open-Meteo works without any key; WAQI adds station readings if set)
WAQI_API_TOKEN=

# Optional: Supabase / PostgreSQL persistence (uses local JSON store fallback if omitted)
# Server-only variables; no client code reads these values.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Security: required in production; at least 32 random characters for signed, HttpOnly session cookies.
SESSION_COOKIE_SECRET=

# Security: optional shared token that locks Vercel Preview deployments; send it in the x-preview-token header.
PREVIEW_ACCESS_TOKEN=

# Security: bearer token for future /admin or /api/admin routes; leave unset to disable admin access.
ADMIN_TOKEN=

# Security: comma-separated extra origins allowed to call the API (same-origin is always allowed).
ALLOWED_ORIGINS=
